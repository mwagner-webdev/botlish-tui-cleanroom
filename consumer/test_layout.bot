# Pure tests: layout allocation and widgets.  No terminal.
import std::list
import std::str
import std::test
import tui::style
import tui::text
import tui::input
import tui::canvas
import tui::layout
import tui::widgets

fn s(c: UnicodeChar) -> str:
    "".append_char(c)

fn plain() -> tui::style::Style:
    tui::style::plain()

fn lab(text: str) -> tui::layout::Node:
    tui::layout::label(text, plain())

fn rect(x: int, y: int, w: int, h: int) -> tui::canvas::Rect:
    tui::canvas::rect(x, y, w, h)

fn picture(width: int, height: int, node: tui::layout::Node) -> List[str]:
    tui::canvas::new(width, height).draw(node).rasterize().lines()

fn heights(node: tui::layout::Node, width: int, height: int) -> List[int]:
    rects = node.rects(rect(0, 0, width, height))
    loop each in rects:
        each.h

fn widths(node: tui::layout::Node, width: int, height: int) -> List[int]:
    rects = node.rects(rect(0, 0, width, height))
    loop each in rects:
        each.w

# The background colour of the cell at (x, y); -9 outside the screen.
fn background_at(screen: tui::canvas::Screen, x: int, y: int) -> int:
    c = screen.cell_at(x, y):
        on tui::canvas::OutOfBounds:
            return -9
    c.bg

fn key(kind: tui::input::Kind) -> tui::input::Event:
    tui::input::key(kind)

fn typed(text: str) -> List[tui::input::Event]:
    tui::input::decode_text(text)

# Apply events to a text input / list, in order.
fn edit(t: tui::widgets::TextInput, events: List[tui::input::Event]) -> tui::widgets::TextInput:
    fold e in events with intermediate acc t:
        acc.input_update(e)

fn navigate(l: tui::widgets::ListState, events: List[tui::input::Event]) -> tui::widgets::ListState:
    fold e in events with intermediate acc l:
        acc.list_update(e)

fn sum_of(xs: List[int]) -> int:
    fold x in xs with intermediate acc 0:
        acc + x

fn reg_layout():
    fn vertical_natural():
        picture(6, 4, tui::layout::vstack([lab("one"), lab("two"), lab("three")]))
    std::test::value("layout: vertical stack uses natural heights", ["one   ", "two   ", "three ", "      "], vertical_natural)

    fn horizontal_natural():
        picture(12, 1, tui::layout::hstack([lab("ab"), lab("cde"), lab("fg")]))
    std::test::value("layout: horizontal stack uses natural widths", ["abcdefg     "], horizontal_natural)

    fn natural_sizes():
        a = tui::layout::vstack([lab("abc"), lab("de")]).measure()
        b = tui::layout::hstack([lab("abc"), lab("de")]).measure()
        {v: a, h: b}
    std::test::value("layout: natural size of stacks", {v: tui::layout::Size {w: 3, h: 2}, h: tui::layout::Size {w: 5, h: 1}}, natural_sizes)

    fn flex_proportional():
        node = tui::layout::hstack([lab(s('a')).with_flex(1), lab(s('b')).with_flex(2)])
        node.widths(10, 1)
    std::test::value("layout: flex shares are proportional and add up exactly", [10, 3, 7], flex_proportional)

    fn flex_remainder():
        node = tui::layout::hstack([lab(s('a')).with_flex(1), lab(s('b')).with_flex(1), lab(s('c')).with_flex(1)])
        node.widths(10, 1)
    std::test::value("layout: integer remainders are spread deterministically", [10, 3, 3, 4], flex_remainder)

    fn spacer_takes_leftover():
        node = tui::layout::hstack([lab("fixed"), tui::layout::spacer(), lab("end")])
        node.widths(20, 1)
    std::test::value("layout: a spacer takes the leftover space", [20, 5, 12, 3], spacer_takes_leftover)

    fn sum_matches_for_every_size():
        bad = fold total from 0 to 31 with intermediate n 0:
            node = tui::layout::hstack([tui::layout::spacer().with_flex(2), lab("xy"), tui::layout::spacer().with_flex(3), tui::layout::spacer()])
            kids = node.widths(total, 1)
            parts = loop i from 1 to 5:
                kids.get(i, 0)
            if sum_of(parts) == total:
                n
            else:
                n + 1
        bad
    std::test::value("layout: children fill exactly the space, for every width 0..30", 0, sum_matches_for_every_size)

    fn insufficient_space():
        node = tui::layout::hstack([lab("aaaa"), lab("bbbb"), lab("cccc")])
        node.widths(6, 1)
    std::test::value("layout: when space runs out later children are truncated, then get 0", [6, 4, 2, 0], insufficient_space)

    fn insufficient_drops_flex():
        node = tui::layout::hstack([lab("aaaa"), tui::layout::spacer()])
        node.widths(3, 1)
    std::test::value("layout: flex children get nothing when fixed ones need all the space", [3, 3, 0], insufficient_drops_flex)

    fn truncated_drawing():
        picture(6, 1, tui::layout::hstack([lab("aaaa"), lab("bbbb"), lab("cccc")]))
    std::test::value("layout: truncated children are clipped, never overlapping", ["aaaabb"], truncated_drawing)

    fn zero_space():
        {zero_w: picture(0, 3, tui::layout::vstack([lab("abc")])), zero_h: picture(4, 0, tui::layout::vstack([lab("abc")]))}
    std::test::value("layout: zero-sized areas draw nothing", {zero_w: ["", "", ""], zero_h: []}, zero_space)

    fn empty_stacks():
        {v: picture(3, 1, tui::layout::vstack([])), h: picture(3, 1, tui::layout::hstack([]))}
    std::test::value("layout: empty stacks are fine", {v: ["   "], h: ["   "]}, empty_stacks)

    fn vertical_flex():
        node = tui::layout::vstack([lab("top"), tui::layout::fill(plain()), lab("bottom")])
        node.heights(6, 5)
    std::test::value("layout: vertical flex", [5, 1, 3, 1], vertical_flex)

    fn cross_axis_width():
        node = tui::layout::vstack([lab("abc").with_width(2), lab("de")])
        node.widths(10, 3)
    std::test::value("layout: cross axis uses the child's own width when smaller", [10, 2, 10], cross_axis_width)

    fn padding():
        picture(7, 3, lab("ab").padded(2, 1, 0, 0))
    std::test::value("layout: padding insets the child", ["       ", "  ab   ", "       "], padding)

    fn padding_clips():
        picture(5, 3, lab("abcdef").padded_all(1))
    std::test::value("layout: padded content is clipped inside the padding", ["     ", " abc ", "     "], padding_clips)

    fn boxed_titled():
        picture(12, 4, lab("hello").boxed("Title", tui::canvas::BorderKind::Single, plain()))
    std::test::value("layout: a box draws border, title and child", ["┌─ Title ──┐", "│hello     │", "│          │", "└──────────┘"], boxed_titled)

    fn boxed_small():
        {tight: picture(4, 3, lab(s('x')).boxed("Long title", tui::canvas::BorderKind::Ascii, plain())), flat: picture(5, 1, lab("xyz").boxed(s('t'), tui::canvas::BorderKind::Ascii, plain()))}
    std::test::value("layout: a box too small for its title or child degrades without error", {tight: ["+--+", "|x |", "+--+"], flat: ["     "]}, boxed_small)

    fn nested():
        ui = tui::layout::vstack([lab("header"), tui::layout::hstack([lab(s('L')), tui::layout::spacer(), lab("in").boxed("", tui::canvas::BorderKind::Ascii, plain())]), tui::layout::spacer(), lab("footer")])
        picture(12, 6, ui)
    std::test::value("layout: nested stacks and boxes", ["header      ", "L       +--+", "        |in|", "        +--+", "            ", "footer      "], nested)

    fn same_node_other_sizes():
        ui = tui::layout::vstack([lab("title"), tui::layout::fill(plain()).with_flex(1), lab("status")])
        {small: picture(8, 3, ui), tall: picture(8, 5, ui)}
    std::test::value("layout: one description renders at any size (dimensions are data)", {small: ["title   ", "        ", "status  "], tall: ["title   ", "        ", "        ", "        ", "status  "]}, same_node_other_sizes)

    fn on_color_paints_background():
        node = tui::layout::label("ab", tui::style::transparent()).on_color(plain().with_bg(tui::style::blue))
        shown = tui::canvas::new(4, 1).draw(node).rasterize()
        {first: shown.background_at(0, 0), last: shown.background_at(3, 0)}
    std::test::value("layout: on_color paints the whole area behind the child", {first: 4, last: 4}, on_color_paints_background)

fn register_all():
    reg_layout()

with context std::test::suite()
register_all()
std::test::report()
