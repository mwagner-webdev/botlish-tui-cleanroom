# tui::session -- Layer B: the Linux terminal session adapter.
#
# This is the ONLY module of the package that touches the operating system.
# Everything above it (canvas, ansi, input, layout, widgets) is pure and
# portable; this module needs a native backend on Linux x86-64 and a real
# terminal.  The standard library has no terminal API (no termios, no isatty,
# no window size, no poll, no signals), so the adapter is built on the
# documented raw-syscall transport std::linux::abi::x86_64::syscall:
#   ioctl(TCGETS/TCSETS)  terminal modes: raw (no line buffering, no echo)
#   ioctl(TIOCGWINSZ)     terminal size
#   poll(2)               wait for input with a timeout, no busy-polling
#   read(2) / write(2)    bytes in and out
# Authority is mediated by the Terminal context: every function that makes a
# syscall requires it, so a program must install it explicitly:
#     with context tui::session::create()
# Terminal state is owned by an `opaque resource struct` (Session) whose
# cleanup restores the terminal when `run` leaves, normally or by an error.
#
# Two ways to run a session, one set of rules:
#   * STANDALONE: `run(app)` owns a loop of its own (poll, read, update, draw).
#     Appropriate when terminal interaction is the program's only activity.
#   * EXTERNALLY DRIVEN: `open_driven` gives the Session without any loop; the
#     program's own event loop decides when to read (read_bytes), write
#     (write_some) and sample the size.  The descriptor is then nonblocking,
#     so a read never waits and a write that cannot proceed says so.  The
#     adapter package tui_event_loop_linux is that loop integration; this
#     module knows nothing of any scheduler.
# Both use the same decoder (tui::input), host (tui::host), renderer
# (tui::display), ownership rule and cleanup.  One Terminal context has one
# owner at a time: a second open fails (TerminalBusy / IoFailed "busy").
#
# Limits, stated honestly:
#   * Resize is detected by sampling TIOCGWINSZ every resize_poll_ms while the
#     terminal is idle (std programs run on a worker thread, so a SIGWINCH
#     signalfd never sees the signal).  Resizes are noticed within that delay.
#   * A lone Escape is resolved by silence: escape_timeout_ms (see tui::input).
#   * Nothing can be restored after SIGKILL/SIGTERM or a crashed process.
#   * Exclusive ownership is per Terminal context, that is per VM: another
#     VM (thread) that installs its own Terminal is not stopped.
#   * Interpreter and `compile` backends refuse the syscalls (NATIVE-ONLY):
#     use -backend cranelift or build a native executable.

import std::list
import std::str
import std::int
import std::mutable_array
import std::abi
import std::abi::bytes
import std::abi::x86_64
import std::linux::abi::x86_64
import std::binary
import std::byte
import tui::text
import tui::canvas
import tui::ansi
import tui::input
import tui::app
import tui::host

escape_timeout_ms = 50
resize_poll_ms = 100

# stream is "input" or "output": the standard stream that is not a terminal.
error NotATerminal:
    stream: str

# operation names the step that failed: configure, read, poll or write.
error IoFailed:
    operation: str

private fn descriptor(n: int) -> std::abi::I32:
    std::abi::i32(n):
        on std::abi::AbiIntegerBelowRange:
            std::abi::i32(-1)
        on std::abi::AbiIntegerAboveRange:
            std::abi::i32(-1)

# Another session already owns this Terminal (open_driven).
error TerminalBusy:
    reason: str

# owner[0] is 1 while a Session made from this Terminal is alive.
opaque context struct Terminal:
    input_fd: std::abi::I32
    output_fd: std::abi::I32
    owner: MutableArray[int]

# The terminal authority.  Install it once, before any session call:
#     with context tui::session::create()
fn create() -> Terminal:
    Terminal {input_fd: std::abi::i32(0), output_fd: std::abi::i32(1), owner: std::mutable_array::from_list([0])}

# A Terminal on other descriptors than standard input and output (a terminal
# opened by the program; descriptors that are not terminals, to test the
# failure paths).  A number outside a C int is the descriptor -1.
fn create_on(input: int, output: int) -> Terminal:
    Terminal {input_fd: descriptor(input), output_fd: descriptor(output), owner: std::mutable_array::from_list([0])}

layout Termios:
    size 36
    align 4
    field iflag: std::binary::U32 at 0
    field oflag: std::binary::U32 at 4
    field cflag: std::binary::U32 at 8
    field lflag: std::binary::U32 at 12
    field line: std::binary::U8 at 16
    field cc: array 19 of std::binary::U8 at 17

layout WinSize:
    size 8
    align 2
    field rows: std::binary::U16 at 0
    field cols: std::binary::U16 at 2
    field xpixel: std::binary::U16 at 4
    field ypixel: std::binary::U16 at 6

layout PollFd:
    size 8
    align 4
    field fd: std::binary::I32 at 0
    field events: std::binary::I16 at 4
    field revents: std::binary::I16 at 6

layout InBuf:
    size 64
    align 1
    field bytes: array 64 of std::binary::U8 at 0

private struct Sys:
    rc: int
    data: std::abi::bytes::MutableBytes

struct Size:
    width: int
    height: int

# saved: the terminal's original termios.  flags: the input descriptor's
# original status flags when the session made it nonblocking, else -1.
opaque resource struct Session:
    saved: std::abi::bytes::Bytes
    flags: int

private fn word(n: int) -> std::abi::x86_64::Register64:
    std::abi::x86_64::register64(n):
        on std::abi::x86_64::Register64BelowRange:
            std::abi::x86_64::register64(0)
        on std::abi::x86_64::Register64AboveRange:
            std::abi::x86_64::register64(0)

private fn buffer(n: int) -> std::abi::bytes::MutableBytes:
    length = std::abi::usize(n):
        on std::abi::AbiIntegerBelowRange:
            std::abi::usize(0)
        on std::abi::AbiIntegerAboveRange:
            std::abi::usize(0)
    std::abi::bytes::zeroed(length)

# ioctl(FD, REQUEST, BUF): BUF is the argument memory.
private fn ioctl(fd: std::abi::I32, request: int, buf: std::abi::bytes::MutableBytes, context term: Terminal) -> Sys:
    d = std::abi::bytes::detach(buf)
    rc = std::linux::abi::x86_64::syscall({rax: word(16), rdi: word(fd.value), rsi: word(request), rdx: std::abi::x86_64::from_mutable_bytes(d)})
    Sys {rc: std::abi::x86_64::to_int(rc), data: d}

# poll(2) of one descriptor for EVENTS (1 input, 4 output), TIMEOUT
# milliseconds; the raw result.
private fn poll_fd(fd: std::abi::I32, events: int, timeout: int, context term: Terminal) -> int:
    mask = if events >= 0 and events <= 32767:
        events
    else:
        0
    request = std::binary::emit(LayoutStruct[PollFd] {fd: fd.value, events: mask, revents: 0}):
        on LayoutExtentMismatch:
            return -22
    d = std::abi::bytes::from_bytes(request)
    rc = std::linux::abi::x86_64::syscall({rax: word(7), rdi: std::abi::x86_64::from_mutable_bytes(d), rsi: word(1), rdx: word(timeout)})
    std::abi::x86_64::to_int(rc)

private fn poll_input(fd: std::abi::I32, timeout: int, context term: Terminal) -> int:
    fd.poll_fd(1, timeout)

# fcntl(2) F_GETFL / F_SETFL of the input descriptor: the raw result.
private fn fcntl(fd: std::abi::I32, command: int, argument: int, context term: Terminal) -> int:
    rc = std::linux::abi::x86_64::syscall({rax: word(72), rdi: word(fd.value), rsi: word(command), rdx: word(argument)})
    std::abi::x86_64::to_int(rc)

# read(2) of up to the buffer's length from FD.
private fn read_into(fd: std::abi::I32, buf: std::abi::bytes::MutableBytes, context term: Terminal) -> Sys:
    d = std::abi::bytes::detach(buf)
    rc = std::linux::abi::x86_64::syscall({rax: word(0), rdi: word(fd.value), rsi: std::abi::x86_64::from_mutable_bytes(d), rdx: word(std::abi::bytes::mutable_length(d).value)})
    Sys {rc: std::abi::x86_64::to_int(rc), data: d}

# One write(2) of DATA to FD; the raw result.
private fn write_once(fd: std::abi::I32, data: std::abi::bytes::Bytes, context term: Terminal) -> int:
    rc = std::linux::abi::x86_64::syscall({rax: word(1), rdi: word(fd.value), rsi: std::abi::x86_64::from_bytes(data), rdx: word(std::abi::bytes::length(data).value)})
    std::abi::x86_64::to_int(rc)

# Write all of DATA, completing short writes and retrying EINTR.
private fn write_all(fd: std::abi::I32, data: std::abi::bytes::Bytes, context term: Terminal) -> unit errors IoFailed:
    total = std::abi::bytes::length(data).value
    if total == 0:
        return unit
    n = fd.write_once(data)
    if n == -4:
        return fd.write_all(data)
    if n <= 0:
        fail IoFailed {operation: "write"}
    if n >= total:
        return unit
    rest = data.slice(n, total):
        on LowerUnderrun:
            fail IoFailed {operation: "write offset"}
        on UpperOverrun:
            fail IoFailed {operation: "write length"}
    fd.write_all(rest)

private fn text_bytes(text: str) -> std::abi::bytes::Bytes:
    std::abi::bytes::from_list(text.encode_utf8())

# Send TEXT (trusted terminal output, typically from tui::ansi) to the terminal.
fn write_text(text: str, context term: Terminal) -> unit errors IoFailed:
    term.output_fd.write_all(text_bytes(text))

# The terminal's current termios as raw bytes (kept to restore it later).
private fn query_termios(context term: Terminal) -> std::abi::bytes::MutableBytes errors NotATerminal:
    r = term.input_fd.ioctl(21505, buffer(36))
    if r.rc < 0:
        fail NotATerminal {stream: "input"}
    r.data

private fn query_size(context term: Terminal) -> Size errors NotATerminal:
    r = term.output_fd.ioctl(21523, buffer(8))
    if r.rc < 0:
        fail NotATerminal {stream: "output"}
    w = std::binary::parse(WinSize, std::abi::bytes::freeze(r.data)):
        on LayoutLengthMismatch:
            fail NotATerminal {stream: "size"}
    if w.cols == 0 or w.rows == 0:
        return Size {width: 80, height: 24}
    Size {width: w.cols, height: w.rows}

# True when both standard input and standard output are terminals.
fn tty?(context term: Terminal) -> bool:
    r = term.input_fd.ioctl(21505, buffer(36))
    s = term.output_fd.ioctl(21523, buffer(8))
    r.rc >= 0 and s.rc >= 0

# The terminal's current size in cells.
fn size(context term: Terminal) -> Size errors NotATerminal:
    query_size()

private fn word32(n: int) -> std::binary::U32:
    if n < 0 or n > 4294967295:
        return 0
    n

private fn clear_bits(flags: int, bits: int) -> std::binary::U32:
    word32(bit_and(flags, bit_xor(4294967295, bits)))

# The termios of raw mode, derived from ORIG by writing individual fields: no
# line buffering, no echo, no signals from the keyboard (Ctrl+C, Ctrl+Z arrive
# as events), no CR/NL translation on input, 8-bit characters; VMIN = 1,
# VTIME = 0 (a read returns after one byte).  Every other byte is kept.
# If ORIG is malformed it is returned unchanged.
private fn raw_fields(orig: std::abi::bytes::MutableBytes) -> std::abi::bytes::MutableBytes errors LayoutLengthMismatch:
    t = std::binary::parse(Termios, std::abi::bytes::freeze(orig))
    a = std::binary::write(orig, Termios.iflag, t.iflag.clear_bits(1522))
    b = std::binary::write(a, Termios.cflag, word32(bit_or(t.cflag.clear_bits(304), 48)))
    c = std::binary::write(b, Termios.lflag, t.lflag.clear_bits(32843))
    d = std::binary::write(c, Termios.cc[5], 0)
    std::binary::write(d, Termios.cc[6], 1)

private fn raw_termios(orig: std::abi::bytes::MutableBytes) -> std::abi::bytes::MutableBytes:
    raw_fields(orig):
        on LayoutLengthMismatch:
            orig

private fn apply_termios(data: std::abi::bytes::MutableBytes, context term: Terminal) -> int:
    term.input_fd.ioctl(21506, data).rc

private fn prelude() -> str:
    tui::ansi::enter_alternate_screen().concat(tui::ansi::disable_wrap()).concat(tui::ansi::hide_cursor()).concat(tui::ansi::clear_screen())

private fn postlude() -> str:
    tui::ansi::reset_style().concat(tui::ansi::enable_wrap()).concat(tui::ansi::show_cursor()).concat(tui::ansi::leave_alternate_screen())

# --- ownership: one Session per Terminal context

private fn owner_state(context term: Terminal) -> int:
    term.owner.at(0):
        on IndexNotFound:
            1

private fn set_owner(state: int, context term: Terminal):
    term.owner.set(0, state):
        on IndexNotFound:
            return unit
    unit

# Take the Terminal: false when a Session already owns it.
private fn claim(context term: Terminal) -> bool:
    if owner_state() != 0:
        return false
    set_owner(1)
    true

# True while a Session made from this Terminal is alive.
fn owned?(context term: Terminal) -> bool:
    owner_state() != 0

# --- cleanup

# Write DATA to the output with a bounded patience (at most about one second
# in all, however often the terminal refuses): a cleanup must never hang on a
# terminal that stopped draining its output.
private fn write_bounded(data: std::abi::bytes::Bytes, budget: int, context term: Terminal):
    total = std::abi::bytes::length(data).value
    if total == 0 or budget <= 0:
        return unit
    n = term.output_fd.write_once(data)
    if n == -4:
        return data.write_bounded(budget - 1)
    if n == -11:
        term.output_fd.poll_fd(4, 50)
        return data.write_bounded(budget - 1)
    if n <= 0 or n >= total:
        return unit
    rest = data.slice(n, total):
        on LowerUnderrun:
            return unit
        on UpperOverrun:
            return unit
    rest.write_bounded(budget)

# Restores the terminal: screen state first, then the input descriptor's
# original flags, then the saved termios, and finally gives up the ownership.
# Runs automatically where the Session's owner ends, including after an error,
# a cancelled task and an abandoned coroutine.  An externally driven session's
# descriptor is nonblocking, so its screen restore is written with a bounded
# patience; a standalone session's is an ordinary blocking write.
cleanup fn restore(session: Session, context term: Terminal):
    {saved, flags} = session
    if flags >= 0:
        text_bytes(postlude()).write_bounded(20)
        term.input_fd.fcntl(4, flags)
    else:
        write_text(postlude()):
            on IoFailed:
                unit
    apply_termios(std::abi::bytes::from_bytes(saved))
    set_owner(0)
    unit

# Put the terminal in raw mode on the alternate screen, claiming it.  DRIVEN
# also makes the input descriptor nonblocking (after the first screen write).
private fn start(driven: bool, context term: Terminal) -> Session errors NotATerminal, IoFailed, TerminalBusy:
    if not claim():
        fail TerminalBusy {reason: "a session already owns this terminal"}
    saved = query_termios():
        on NotATerminal {stream}:
            set_owner(0)
            fail NotATerminal {stream: stream}
    size = query_size():
        on NotATerminal {stream}:
            set_owner(0)
            fail NotATerminal {stream: stream}
    if apply_termios(raw_termios(saved)) < 0:
        set_owner(0)
        fail IoFailed {operation: "configure"}
    original = if driven:
        term.input_fd.fcntl(3, 0)
    else:
        -1
    session = Session {saved: std::abi::bytes::freeze(saved), flags: original}
    write_text(prelude())
    if driven and (original < 0 or term.input_fd.fcntl(4, bit_or(original, 2048)) < 0):
        fail IoFailed {operation: "nonblocking"}
    session

# Put the terminal in raw mode on the alternate screen.  The returned Session
# is the obligation to restore it (a resource: it is released at the end of
# the scope that owns it).  Fails with IoFailed "busy" when this Terminal
# already has a Session.
fn open(context term: Terminal) -> Session errors NotATerminal, IoFailed:
    start(false):
        on TerminalBusy {reason}:
            fail IoFailed {operation: "busy"}

# As open, for a program whose own event loop drives the terminal: the input
# descriptor is also made nonblocking (its original flags are restored by the
# Session's cleanup), so that read_bytes never waits.  There is no loop here:
# see read_bytes, write_some, size and tui::host.  Fails with TerminalBusy when
# this Terminal already has a Session.
fn open_driven(context term: Terminal) -> Session errors NotATerminal, IoFailed, TerminalBusy:
    start(true)

# --- input

private struct Chunk:
    count: int
    bytes: List[int]

private fn read_chunk(context term: Terminal) -> Chunk:
    r = term.input_fd.read_into(buffer(64))
    parsed = std::binary::parse(InBuf, std::abi::bytes::freeze(r.data)):
        on LayoutLengthMismatch:
            return Chunk {count: -22, bytes: []}
    n = if r.rc > 64:
        64
    else:
        r.rc
    bytes = loop i from 0 to n:
        tui::text::widen(parsed.bytes.get(i, 0))
    Chunk {count: r.rc, bytes: bytes}

# What one read of the input found.
#   Data    bytes were read
#   Idle    nothing to read right now (a nonblocking descriptor; also EINTR)
#   Closed  end of file: no more input will come
#   Hangup  the terminal went away (EIO)
enum Reading:
    Data,
    Idle,
    Closed,
    Hangup,

struct Input:
    state: Reading
    bytes: List[int]

# One read(2) of at most 64 bytes, bytes as 0..255.  Never waits on a
# descriptor made nonblocking by open_driven: absence of input is Idle, never
# Closed.  Any other failure of the read is IoFailed "read".
fn read_bytes(context term: Terminal) -> Input errors IoFailed:
    chunk = read_chunk()
    if chunk.count == 0:
        return Input {state: Reading::Closed, bytes: []}
    if chunk.count == -4 or chunk.count == -11:
        return Input {state: Reading::Idle, bytes: []}
    if chunk.count == -5:
        return Input {state: Reading::Hangup, bytes: []}
    if chunk.count < 0:
        fail IoFailed {operation: "read"}
    Input {state: Reading::Data, bytes: chunk.bytes}

# The descriptors this Terminal reads and writes (to watch for readiness).
fn input_descriptor(context term: Terminal) -> int:
    term.input_fd.value

fn output_descriptor(context term: Terminal) -> int:
    term.output_fd.value

# --- output

# TEXT (trusted terminal output) as bytes, to write with write_some.
fn encode(text: str) -> std::abi::bytes::Bytes:
    text_bytes(text)

fn encoded_length(data: std::abi::bytes::Bytes) -> int:
    std::abi::bytes::length(data).value

# One write(2) of the bytes of DATA from OFFSET, at most LIMIT of them.
# Returns the new offset: unchanged when the terminal cannot take anything now
# (a nonblocking output that is full: wait until it is writable, then call
# again).  Writing a frame in several calls is correct because the caller keeps
# the offset; a frame that is abandoned half-written leaves the terminal in an
# unknown state (tui::host::frame_failed).  IoFailed "write" when the terminal
# is gone.
fn write_some(data: std::abi::bytes::Bytes, offset: int, limit: int, context term: Terminal) -> int errors IoFailed:
    total = std::abi::bytes::length(data).value
    if offset >= total or limit <= 0:
        return offset
    stop = if offset + limit < total:
        offset + limit
    else:
        total
    part = data.slice(offset, stop):
        on LowerUnderrun:
            fail IoFailed {operation: "write offset"}
        on UpperOverrun:
            fail IoFailed {operation: "write length"}
    n = term.output_fd.write_once(part)
    refused = n == -4 or n == -11
    if n <= 0 and not refused:
        fail IoFailed {operation: "write"}
    progress = if refused:
        0
    else:
        n
    offset + progress

# --- the standalone loop

# The size at wake-up as one more transition: FIRST's events, then a Resize
# event when the size changed.
private fn with_size(first: tui::host::Fed, now: Size) -> tui::host::Fed:
    second = first.host.resized(now.width, now.height)
    tui::host::Fed {host: second.host, events: [first.events, second.events].flat()}

# Wait up to the idle timeout for input (bytes are decoded, a lone Escape is
# resolved by the escape timeout) and report the size at wake-up.  The events
# are for the application, in order.
private nomethod fn wait(host: tui::host::Host, context term: Terminal) -> tui::host::Fed errors NotATerminal, IoFailed:
    timeout = if host.pending_input?():
        50
    else:
        100
    rc = term.input_fd.poll_input(timeout)
    now = query_size()
    if rc == 0 or rc == -4:
        return host.silence().with_size(now)
    if rc < 0:
        fail IoFailed {operation: "poll"}
    read = read_bytes()
    if read.state == Reading::Closed:
        return host.end_of_input()
    if read.state == Reading::Hangup:
        fail IoFailed {operation: "read"}
    if read.state == Reading::Idle:
        return tui::host::Fed {host: host, events: []}.with_size(now)
    host.feed(read.bytes).with_size(now)

private nomethod fn drive(app: tui::app::Application, host: tui::host::Host, context term: Terminal) -> unit errors NotATerminal, IoFailed, tui::app::Abort:
    if host.done?(app):
        return unit
    shown = if host.wants_frame?(app):
        frame = host.frame(app)
        write_text(frame.text):
            on IoFailed {operation}:
                fail IoFailed {operation: operation}
        frame.host
    else:
        host
    woke = wait(shown)
    next = tui::app::apply_events(app, woke.events, 0)
    drive(next, woke.host)

# Run APP in the terminal until finished?(app) is true or the input ends.  The
# terminal is restored before run returns or fails.  Fails with NotATerminal
# when stdin/stdout are not terminals, IoFailed when the terminal cannot be
# configured, read or written (or is already owned by another session), and
# tui::app::Abort when the application's update fails.
fn run(app: tui::app::Application, context term: Terminal) -> unit errors NotATerminal, IoFailed, tui::app::Abort:
    session = open()
    start_size = query_size()
    drive(app, tui::host::new(start_size.width, start_size.height))
